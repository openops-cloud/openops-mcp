# Copy to .env and adjust. Both transports serve the same tools; only the
# authentication differs.
#
#   stdio  one service principal, the token handed in by whoever spawns us
#   http   many users, each request authorized by the OAuth token it carries

MCP_TRANSPORT=stdio

# ----------------------------------------------------------------- both transports

# Base URL of the OpenOps API.
OPENOPS_API_URL=http://localhost:3000

# The operations exposed as tools. Startup fails on an entry the API does not
# serve, so a mistyped path is reported rather than silently missing a tool.
OPENOPS_MCP_ROUTES=config/routes.oss.yaml

# Where to read the OpenAPI document. Defaults to
# ${OPENOPS_API_URL}/v1/openapi/json, which is correct for most deployments.
# OPENOPS_API_OPENAPI_URL=http://localhost:3000/v1/openapi/json

# ------------------------------------------------------------------ stdio only

# Bearer token used for every API call. The whole server acts as this one
# principal, so only a trusted parent process should supply it.
AUTH_TOKEN=

# ------------------------------------------------------------------- http only

# The OpenOps instance acting as the OAuth authorization server. Inbound tokens
# are verified against its published keys and exchanged at its token endpoint.
# OPENOPS_MCP_ISSUER=http://localhost:3000

# This server's own canonical URL, and the audience it accepts tokens for. Must
# differ from the issuer: a token minted for the API must not be accepted here.
# OPENOPS_MCP_RESOURCE_URL=http://localhost:3020/mcp

# How this server authenticates to the authorization server when exchanging a
# caller's token for an API one. At least 32 characters, and it must match
# OPS_OAUTH_RS_CLIENT_SECRET in the OpenOps API.
# OPENOPS_MCP_CLIENT_SECRET=

# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=3020

# ------------------------------------------------------------------- telemetry

ENVIRONMENT=development
# LOGZIO_TOKEN=
