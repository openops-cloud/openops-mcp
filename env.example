# Copy to .env and adjust. Both transports serve the same tools; only the
# authentication differs.
#
#   stdio  one service principal, the token handed in by whoever spawns us
#   http   many users, each request authorized by the OAuth token it carries
#
# An exported variable always wins over this file. The file does fill in what the
# environment omits, which is why a checkout configured for http can otherwise
# hijack a process spawned to speak stdio.

MCP_TRANSPORT=stdio

# ----------------------------------------------------------------- both transports

# Base URL of the OpenOps API. Tool calls go here.
OPENOPS_API_URL=http://localhost:3000

# Which surface the API publishes for this server to serve. The API decides what
# each contains, so there is no list of operations here.
#
#   chat   the built-in AI chat: read-mostly
#   agent  external OAuth clients: whatever surface the API publishes for them
OPENOPS_MCP_PROFILE=agent

# Where to read that document. Defaults to
# ${OPENOPS_API_URL}/v1/mcp/openapi.json?profile=${OPENOPS_MCP_PROFILE}.
# OPENOPS_API_OPENAPI_URL=

# Read the document from a file instead, and skip the fetch. This is what the API
# passes when it spawns this server; it wins over any URL.
# OPENOPS_API_OPENAPI_PATH=

# ------------------------------------------------------------------ stdio only

# Bearer token used for every API call. The whole server acts as this one
# principal, so only a trusted parent process should supply it.
AUTH_TOKEN=

# ------------------------------------------------------------------- http only

# The OpenOps instance acting as the OAuth authorization server. Inbound tokens
# are verified against its published keys and exchanged at its token endpoint.
# Must equal OPS_OAUTH_ISSUER_URL in the API exactly: it is compared against the
# iss claim on every request.
# OPENOPS_MCP_ISSUER=http://localhost:3000

# This server's own canonical URL, and the audience it accepts tokens for. Must
# differ from the issuer: a token minted for the API must not be accepted here.
# Must equal OPS_MCP_RESOURCE_URL in the API.
# OPENOPS_MCP_RESOURCE_URL=http://localhost:3020/mcp

# How this server authenticates to the authorization server when exchanging a
# caller's token for an API one. At least 32 characters, and it must match
# OPS_OAUTH_RS_CLIENT_SECRET in the OpenOps API.
# OPENOPS_MCP_CLIENT_SECRET=

# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=3020

# ------------------------------------------------------------------- telemetry

ENVIRONMENT=development
# LOGZIO_TOKEN=
